# Set default behavior: text files are normalized to LF in the repository
* text=auto

# Force LF for source files (cross-platform, preferred)
*.py       text eol=lf
*.sh       text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.xml      text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.vue      text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf

# Keep native (CRLF) for Windows script files
*.bat      text eol=crlf
*.ps1      text eol=crlf

# Binary files (do not attempt to normalize)
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.zip      binary
*.gz       binary
*.tgz      binary
*.exe      binary
*.dll      binary
*.so       binary
*.dylib    binary

# Preserve executable bit for shell scripts
*.sh       eol=lf

# End of file
