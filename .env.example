# 复制本文件为 .env 并填写密钥。切勿将 .env 提交到版本库。

# 接入形态：siliconflow | bailian | local_vllm | local_ollama
LLM_PROVIDER=siliconflow

# 对话与嵌入共用同一兼容端点时，使用同一密钥即可（SiliconFlow 示例）
LLM_API_KEY=请填写你的密钥
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# 若 LLM_PROVIDER=bailian 且希望单独配置百炼密钥，可填写（否则沿用 LLM_API_KEY）
# DASHSCOPE_API_KEY=

LLM_TIMEOUT=120

# GraphRAG 建索引：免费 API 易触发 429/TPM，默认已压低并发；仍报错可改为 1 或再降 GRAPHRAG_EMBEDDING_BATCH_NUM
# 官方说明：https://docs.siliconflow.cn/en/userguide/rate-limits/rate-limit-and-upgradation
# GRAPHRAG_LLM_MAX_ASYNC=2
# GRAPHRAG_EMBEDDING_MAX_ASYNC=2
# GRAPHRAG_EMBEDDING_BATCH_NUM=8

# 前端开发跨域
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
