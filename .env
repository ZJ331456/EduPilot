# 阿里云百炼API配置示例
# 复制此文件为 .env 并填入你的实际配置

# 阿里云百炼API Key
# 获取地址: https://bailian.console.aliyun.com/
QWEN_API_KEY=sk-0680b9634a644828a3a9622143c0c079

# 可选配置
# LLM模型名称 (默认: qwen-plus-2025-07-14)
# LLM_MODEL=qwen-plus-2025-07-14

# LLM API基础URL (默认: https://dashscope.aliyuncs.com/compatible-mode/v1)
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM最大令牌数 (默认: 2000)
# LLM_MAX_TOKENS=2000

# LLM温度参数 (默认: 0.7)
# LLM_TEMPERATURE=0.7

# 是否默认启用LLM增强 (默认: true)
# LLM_ENHANCEMENT_ENABLED=true

# API服务配置
# API_HOST=127.0.0.1
API_HOST=0.0.0.0
API_MAIN_PORT=8000
API_DEBUG=false

# MongoDB配置
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=hw_agent_db

# 数据库连接池配置
DB_MIN_POOL_SIZE=10
DB_MAX_POOL_SIZE=100
DB_MAX_IDLE_TIME_MS=30000


# 系统配置
LOG_LEVEL=INFO
DEBUG=false